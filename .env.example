# ── Job aggregator (server-side only — never prefix these with VITE_) ──
# Service-role key: Supabase → Project Settings → API. Needed to import jobs.
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret for the hourly cron calling /api/sync-jobs (any long random string)
CRON_SECRET=
# Optional: JSearch on RapidAPI → LinkedIn, Indeed, Glassdoor, ZipRecruiter listings
JSEARCH_API_KEY=
JSEARCH_QUERIES=jobs in Nigeria,jobs in Kenya,jobs in South Africa,jobs in Ghana,remote jobs Africa,graduate jobs Africa,visa sponsorship jobs
# Optional: Adzuna (https://developer.adzuna.com)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRIES=za,gb,us,ca
# Optional: X API v2 bearer token (Basic tier or above) for "we're hiring" posts
X_BEARER_TOKEN=
# Optional: Upwork GraphQL API OAuth2 access token (approved Upwork app)
UPWORK_ACCESS_TOKEN=
# ── KYC screening ──
# Secret used to hash ID numbers for duplicate detection (any long random string).
# Set it once and never change it, or previously stored hashes stop matching.
KYC_HASH_SECRET=
# ── Business directory import (OpenStreetMap) ──
BUSINESS_CITIES_PER_RUN=4
# Optional: employer career boards (comma-separated slugs)
GREENHOUSE_BOARDS=
LEVER_COMPANIES=
# ── Payments (wallet top-ups) — https://dashboard.paystack.com/#/settings/developers ──
# Use sk_test_… while testing. Webhook URL: https://YOUR-SITE/api/paystack-webhook
PAYSTACK_SECRET_KEY=
# Public site URL used for the checkout return link (optional; defaults to the request host)
PUBLIC_SITE_URL=
# ── Extra job sources ──
# MyJobMag (Nigeria by default; add gh,ke,za for Ghana/Kenya/South Africa). Set to false to disable.
MYJOBMAG_ENABLED=true
MYJOBMAG_SITES=ng
MYJOBMAG_PAGES=30
# More employer career boards (comma-separated board names); admins can also add them in Admin → Job import
ASHBY_BOARDS=
WORKABLE_ACCOUNTS=

# --- Supabase Auth setup (node scripts/supabase-auth-setup.mjs) ---
# Personal access token: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
# Google sign-in (Google Cloud > APIs & Services > Credentials > OAuth client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Custom SMTP so confirmation emails reach every user (sender name shown in inboxes)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=
SMTP_SENDER_NAME=AfriTalent

# Sign in with Indeed (node scripts/setup-indeed-login.mjs) — app at https://secure.indeed.com/account/apikeys
INDEED_CLIENT_ID=
INDEED_CLIENT_SECRET=
