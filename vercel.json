{
  "crons": [
    {
      "path": "/api/sync-jobs",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/sync-businesses",
      "schedule": "30 2 * * *"
    }
  ],
  "functions": {
    "api/sync-jobs.js": {
      "maxDuration": 300
    },
    "api/sync-businesses.js": {
      "maxDuration": 300
    },
    "api/kyc-check.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/kyc-specimen.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/wallet-topup.js": {
      "maxDuration": 30
    },
    "api/wallet-verify.js": {
      "maxDuration": 30
    },
    "api/paystack-webhook.js": {
      "maxDuration": 30
    },
    "api/career-board-test.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self), payment=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
